{
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "vite serve",
    "preview": "vite preview",
    "build:prod": "NODE_ENV=production vite build --minify",
    "build:dev": "NODE_ENV=dev vite build",
    "generate": "run-p typecheck \"build:prod\"",
    "postinstall": "yarn prepare",
    "prepare": "husky && husky install",
    "lint": "eslint . && yarn typecheck",
    "codestyle": "eslint . --fix",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "sb": "storybook dev -p 6006",
    "test:unit": "vitest",
    "typecheck": "vue-tsc --build --force",
    "size": "node scripts/check-bundle-size.mjs",
    "format": "prettier --write src/"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ],
    "*.{vue,html}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-attributes": "^7.24.7",
    "@conarti/eslint-plugin-feature-sliced": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-links": "^10.3.3",
    "@storybook/builder-vite": "^10.3.3",
    "@storybook/vue3": "^10.3.3",
    "@storybook/vue3-vite": "^10.3.3",
    "@tsconfig/node20": "^20.1.4",
    "@types/downloadjs": "^1.4.3",
    "@types/jsdom": "^21.1.7",
    "@types/lodash.debounce": "^4.0.7",
    "@types/lodash.isstring": "^4.0.9",
    "@types/node": "^20.14.5",
    "@types/pluralize": "^0.0.33",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/devtools-kit": "^7.4.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-storybook": "10.3.3",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "husky": "^9.0.11",
    "jsdom": "^24.1.0",
    "lint-staged": "^15.2.7",
    "npm-run-all2": "^6.2.0",
    "nuxi": "^3.3.1",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "prettier": "^3.2.5",
    "sass": "^1.108.0",
    "storybook": "^10.3.3",
    "typescript": "^5.4.0",
    "vite": "^7.3.7",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@floating-ui/vue": "^1.1.2",
    "@highlightjs/vue-plugin": "^2.1.2",
    "@sentry/types": "^8.15.0",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^10.11.0",
    "centrifuge": "^5.8.0",
    "dompurify": "3.4.17",
    "downloadjs": "^1.4.7",
    "flame-chart-js": "^3.3.0",
    "highlight.js": "^11.7.0",
    "html-to-image": "^1.11.4",
    "lodash.debounce": "^4.0.8",
    "lodash.isstring": "^4.0.1",
    "moment": "^2.31.0",
    "pinia": "^2.1.7",
    "pluralize": "^8.0.0",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.45",
    "vue-router": "^4.3.3",
    "vue3-tabs-component": "^1.2.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
